<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FispaSspr.Web</RootNamespace>
    <AssemblyName>FispaSSPR</AssemblyName>
    <Version>0.5.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- .NET 10 LTS (supporto fino a novembre 2028). Il servizio gira solo su Windows (AD, DPAPI-NG, servizio Windows) -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.14" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Texts\texts.*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FispaSspr.Core\FispaSspr.Core.csproj" />
  </ItemGroup>

</Project>
