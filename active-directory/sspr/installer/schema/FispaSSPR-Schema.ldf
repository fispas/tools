# FispaSSPR - estensione dello schema di Active Directory
# Importare con:  ldifde -i -f FispaSSPR-Schema.ldf -c "DC=X" "<DN della radice della foresta>" -k
# Va eseguito da un membro di Schema Admins, sul DC che ha il ruolo di Schema Master.
# ATTENZIONE: le aggiunte allo schema sono permanenti (si possono disattivare, non eliminare).
# OID: radice 1.2.840.113556.1.8000.2554.5811.899.4382.19277.44156.3796773.11388313 (metodo Microsoft da GUID)
#   .1.x attributi, .2.x classi. Gli schemaIDGUID sono fissi: servono per le ACL per attributo.

dn: CN=fispaSspr-Totp,CN=Schema,CN=Configuration,DC=X
changetype: ntdsSchemaAdd
objectClass: top
objectClass: attributeSchema
cn: fispaSspr-Totp
lDAPDisplayName: fispaSsprTotp
adminDisplayName: fispaSspr-Totp
adminDescription: FispaSSPR - segreto TOTP cifrato (AES-256-GCM)
attributeID: 1.2.840.113556.1.8000.2554.5811.899.4382.19277.44156.3796773.11388313.1.1
attributeSyntax: 2.5.5.12
oMSyntax: 64
isSingleValued: TRUE
rangeUpper: 2048
searchFlags: 128
isMemberOfPartialAttributeSet: FALSE
showInAdvancedViewOnly: TRUE
systemOnly: FALSE
schemaIDGUID:: 4B4Q4DcTm0ivGBkDD1VBsw==

